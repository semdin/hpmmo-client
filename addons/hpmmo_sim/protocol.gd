const CHAT_SHOUT_PREFIX := "!"
const CHAT_MAX_LENGTH := 200

## Stat delta keys carry the amount and the new absolute value so a client that
## missed an ordered delta still converges on the next full stats message.
const STAT_HP := "hp"
const STAT_MANA := "mana"
const STAT_EXP := "exp"
const STAT_LEVEL := "level"
const STAT_GALLEONS := "galleons"

## Result of validating a client request. `reason` is one of the REJECT_* strings.
static func accept() -> Dictionary:
	return {"ok": true, "reason": REJECT_OK}

static func reject(reason: String) -> Dictionary:
	return {"ok": false, "reason": reason}

static func version_string() -> String:
	return "hpmmo-proto/%d" % PROTOCOL_VERSION

static func mob_variant(scene_path: String) -> int:
	for variant in MOB_SCENES.keys():
		if MOB_SCENES[variant] == scene_path:
			return int(variant)
	return MOB_VARIANT_INFERI

static func mob_scene(variant: int) -> String:
	return String(MOB_SCENES.get(variant, MOB_SCENES[MOB_VARIANT_INFERI]))


; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="HPMMO"
config/description="HPMMO - 3D Wizarding MMORPG with Wand Combat, Dark Monoliths, Ollivander Upgrades, and Broom Mounts"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
DatabaseManager="*res://scripts/server/db_manager.gd"
SimNet="*res://addons/hpmmo_sim/net.gd"
SimAuthority="*res://addons/hpmmo_sim/authority.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
QuestManager="*res://scripts/systems/quest_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode="fullscreen"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
mouse_cursor/custom_image="res://assets/ui/cursor.png"

[gui]

theme/custom_font="res://assets/fonts/AlegreyaSans-Regular.ttf"
theme/custom_font_size=15
theme/custom_theme="res://assets/ui/hpmmo.tres"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true

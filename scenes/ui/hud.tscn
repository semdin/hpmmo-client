[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hd"]
[ext_resource type="Script" path="res://scripts/ui/ui_slot.gd" id="2_slot"]

; The HUD scene carries structure only: node paths, sizes and anchors. Every
; colour, border, corner radius and font comes from `assets/ui/hpmmo.tres` via
; the type variations hud.gd asks for, so there is no stylebox in this file to
; drift out of step with the theme.

[node name="HUD" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("1_hd")

[node name="ExpBar" type="ProgressBar" parent="."]

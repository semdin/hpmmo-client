#include <winres.h>

#define IDI_MAIN 101

// Application + window icon (multi-size ICO generated from assets/branding).
IDI_MAIN ICON "assets/hpmmo.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,0,0,0
 PRODUCTVERSION  2,0,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "HPMMO"
            VALUE "FileDescription",  "HPMMO — Hogwarts MMORPG Launcher"
            VALUE "FileVersion",      "2.0.0"
            VALUE "InternalName",     "HPMMO_Launcher"
            VALUE "OriginalFilename", "HPMMO_Launcher.exe"
            VALUE "ProductName",      "HPMMO Launcher"
            VALUE "ProductVersion",   "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

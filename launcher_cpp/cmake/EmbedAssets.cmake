# Writes a .cpp that embeds files as byte arrays (the SDL launcher's
# counterpart of app.rc RCDATA). Usage:
#   hpmmo_embed_assets(<out.cpp> NAME1 file1 NAME2 file2 ...)
# defines hpmmo::assets::kNAME[] and kNAMESize for every pair.
function(hpmmo_embed_assets out)
    set(body "// Generated by cmake/EmbedAssets.cmake - do not edit.\n#include <cstddef>\n\nnamespace hpmmo {\nnamespace assets {\n")
    set(args ${ARGN})
    list(LENGTH args n)
    math(EXPR last "${n} - 1")
    foreach(i RANGE 0 ${last} 2)
        math(EXPR j "${i} + 1")
        list(GET args ${i} name)
        list(GET args ${j} file)
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hexlen)
        math(EXPR size "${hexlen} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,0x..,)" "\\1\n" bytes "${bytes}")
        string(APPEND body "extern const unsigned char k${name}[] = {\n${bytes}};\nextern const size_t k${name}Size = ${size};\n\n")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    endforeach()
    string(APPEND body "}  // namespace assets\n}  // namespace hpmmo\n")
    file(WRITE "${out}" "${body}")
endfunction()
